#include <Adafruit_GFX.h>
#include <RGBmatrixPanel.h>
#include <SoftwareSerial.h>
#include <vector>

#define CLK 8
#define OE  9
#define LAT 10
#define A   A0
#define B   A1
#define C   A2
#define D   A3

RGBmatrixPanel matrix(A, B, C, D, CLK, LAT, OE, false, 64);
SoftwareSerial BTSerial(2, 3); // RX, TX HC-05

#define TOUCH_PIN 4
#define MIC_PIN A4

const String BT_PASSWORD = "protagent123";

unsigned long lastTouchTime = 0;
int touchCount = 0;

struct Emotion {
  String name;
  const uint16_t* bitmap;  // указатель на bitmap массив
};

std::vector<Emotion> emotions;

void setup() {
  Serial.begin(115200);
  matrix.begin();
  BTSerial.begin(9600);

  pinMode(TOUCH_PIN, INPUT);

  // Добавляем bitmap эмоций сюда (пример ниже)
  // emotions.push_back({"happy", happyBitmap});
  // emotions.push_back({"sad", sadBitmap});
  // emotions.push_back({"bsod", bsodBitmap});

  showEmotion("happy");  // Начинаем с "счастливого" лица
}

void loop() {
  handleBluetooth();
  handleTouch();
  handleMic();
}

void handleBluetooth() {
  if (BTSerial.available()) {
    String input = BTSerial.readStringUntil('\n');
    input.trim();

    if (!input.startsWith("PASSWORD:")) {
      BTSerial.println("ERROR: No password");
      return;
    }

    String pass = input.substring(9);
    if (pass != BT_PASSWORD) {
      BTSerial.println("ERROR: Wrong password");
      return;
    }

    BTSerial.println("Password OK");

    if (BTSerial.available()) {
      String cmd = BTSerial.readStringUntil('\n');
      cmd.trim();
      showEmotion(cmd);
    }
  }
}

void handleTouch() {
  int touchState = digitalRead(TOUCH_PIN);
  if (touchState == HIGH) {
    unsigned long now = millis();
    if (now - lastTouchTime > 500) {
      touchCount++;
      lastTouchTime = now;
    }
  }
  if (touchCount >= 3) {
    showEmotion("bsod");
    touchCount = 0;
  }
}

void handleMic() {
  int micValue = analogRead(MIC_PIN);
  if (micValue > 600) {
    // Например, показать рот открытым (анимация разговора)
    showEmotion("talking");
  } else {
    // Возврат к предыдущей эмоции или "happy"
    showEmotion("happy");
  }
}

void showEmotion(String name) {
  matrix.fillScreen(0);

  for (auto &e : emotions) {
    if (e.name == name) {
      drawBitmap(e.bitmap);
      return;
    }
  }
  // Если эмоция не найдена - можно очистить экран или показать ошибку
  matrix.fillScreen(0);
}

void drawBitmap(const uint16_t* bitmap) {
  for (int y=0; y<32; y++) {
    for (int x=0; x<64; x++) {
      uint16_t color = pgm_read_word(&(bitmap[y*64 + x]));
      matrix.drawPixel(x, y, color);
    }
  }
}
